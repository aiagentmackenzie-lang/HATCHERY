48    17:46:19.908980 read(10, "#!/bin/sh\n# Benign \"evasive-shaped\" probe: reconnoiter VM/analysis artifacts, do a timing\n# loop, then exit quietly. Used to capture a REAL strace log as a test fixture.\nhead -20 /proc/cpuinfo > /dev/null 2>&1\ncat /proc/uptime > /dev/null 2>&1\ncat /proc/meminfo > /dev/null 2>&1\ncat /sys/class/dmi/id/product_name > /dev/null 2>&1\ncat /sys/class/dmi/id/sys_vendor > /dev/null 2>&1\ncat /sys/hypervisor/type > /dev/null 2>&1\ncat /proc/self/status > /dev/null 2>&1\ncat /proc/self/maps > /dev/null 2>&1\ncat /proc/1/cmdline > /dev/null 2>&1\ncommand -v strace gdb ltrace tcpdump inotifywait gcore > /dev/null 2>&1\nfor i in 1 2 3 4 5; do\n  date +%s > /dev/null 2>&1\n  sleep 0.1\ndone\nsleep 1\nexit 0\n", 8192) = 691
