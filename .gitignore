# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
*.egg-info/
dist/
build/
*.egg

# Analysis results
results/
uploads/
samples/*.sample
# D28 sample store: the index and the key are local state, never committed.
samples/*.db
samples/*.db-wal
samples/*.db-shm
samples/.sample-key
samples/.sample-keyring
samples/.tmp-ring-*
samples/.tmp-*
samples/.store.lock
samples/*.exe
samples/*.elf
samples/*.dll
data/

# D32 audit archives: operator evidence, never committed.
audit-archives/
audit-*.jsonl
audit-*.jsonl.gz
audit-*.manifest.json

# Node
node_modules/
dashboard/dist/
server/dist/
*.tsbuildinfo

# OS
.DS_Store
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.iml

# Docker
*.log

# Real behavioural fixtures are part of the test suite and MUST be tracked.
# Without this negation `*.log` silently excluded the strace fixture the parser
# tests are written against, so CI could not run the test it backs.
!tests/fixtures/*.log
!tests/fixtures/**/*.log
